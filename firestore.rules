rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Courses ---
    match /courses/{courseId} {
      allow read: if isSignedIn(); // Teachers can read their courses
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // --- Students ---
    function isValidStudent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 256;
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStudent(request.resource.data);
      allow update: if isSignedIn() && isValidStudent(request.resource.data);
      allow delete: if isSignedIn();
    }

    // --- Observations ---
    match /observations/{obsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Conflicts ---
    match /conflicts/{conflictId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Agreements ---
    match /agreements/{agId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Milestones ---
    match /milestones/{milestoneId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Sessions ---
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Sociogram Data (Multi-year) ---
    // Allow server to write imported PULSO.cl data without user auth
    // Allow anyone to read (not sensitive data)
    match /sociogram_2024/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_2025/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_2026/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_2027/{courseId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
