rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Courses ---
    match /courses/{courseId} {
      allow read: if isSignedIn(); // Teachers can read their courses
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    // --- Students ---
    function isValidStudent(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 256;
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidStudent(request.resource.data);
      allow update: if isSignedIn() && isValidStudent(request.resource.data);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.teacherId;

      // Form responses sub-collection
      match /formResponses/{responseId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    // --- Observations ---
    match /observations/{obsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Conflicts ---
    match /conflicts/{conflictId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Agreements ---
    match /agreements/{agId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Milestones ---
    match /milestones/{milestoneId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Sessions ---
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Sociogram Data (Multi-year) ---
    // SECURITY NOTE: These rules are intentionally open for server-side operations:
    // 1. Server-side import from PULSO.cl uses service credentials (google-services.json),
    //    not end-user auth, so user-level auth checks do not apply
    // 2. The Express server (/api/import/sociogram) handles all import logic and
    //    validates the data before writing to Firestore
    // 3. Sociogram data (relationship networks) is not sensitive PII - it's
    //    structural analysis data about peer relationships, not personal data
    // 4. Read is open to allow the frontend to display sociogram visualizations
    //    without requiring additional auth (data already protected by app auth)
    //
    // If user-facing sociogram editing is needed in the future, this should be
    // restricted to isSignedIn() with teacher ownership checks
    match /sociogram_2024/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_2025/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_2026/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_2027/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    // --- Sociogram Analysis (Course Vision) ---
    // Same rationale as sociogram data above - server-side import and analysis
    match /sociogram_analysis_2024/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_analysis_2025/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_analysis_2026/{courseId} {
      allow read: if true;
      allow write: if true;
    }
    match /sociogram_analysis_2027/{courseId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
